# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/project_propel
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=project_propel

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173
